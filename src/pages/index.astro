---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Wireframe from '../components/Wireframe.astro';
import { Image } from 'astro:assets';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const headline = 'I like knowing how things work, down to the matrix math.';

const statusLabel = {
  active: 'Active',
  paused: 'Paused',
  experiment: 'Experiment',
  done: 'Done',
} as const;
---

<Base
  title="Home"
  description="Clark Hinchcliff is a frontend engineer focused on consistent user experiences. Projects include a WebGL 2 game engine, a Vue and Spring app, and a semantic search experiment."
>
  <section class="hero">
    <div>
      <!--
        Typewriter (see docs/site-shell.md#the-typewriter-headline). Every letter is in the page from the start,
        so the lines wrap once and never jump; the script only reveals them. Screen readers get the plain text.
      -->
      <h1>
        <span class="sr-only">{headline}</span>
        <span class="typed" aria-hidden="true"
          >{
            headline.split(' ').map((word, i) => (
              <>
                {i > 0 && ' '}
                <span class="word">
                  {[...word].map((ch) => (
                    <span class="ch">{ch}</span>
                  ))}
                </span>
              </>
            ))
          }</span
        >
      </h1>
      <p class="lede">
        I'm Clark, a frontend engineer. I specialize in the web, with a focus on user experiences that stay
        consistent. I can find my way around a backend and build my own services too.
      </p>
      <p class="proof">
        <!-- Keep each word on the same line as the link after it: the HTML compressor drops the line break. -->
        I learn best by building things myself. Some of what that's looked like so far:
        a <a href="/projects/smackhem/">3D game engine</a> on WebGL&nbsp;2.0, still very much in progress.
        A <a href="/projects/springvue/">Vue SPA inside a Spring monolith</a>, with a Rust twin to see how the two compare.
        A <a href="/projects/vector-rag-nuxt/">semantic search</a> over real car data, which I'm learning as I go.
        And <a href="/projects/shotlify/">Shotlify</a>, which pulls still frames out of video in the browser,
        with <a href="/projects/images-to-slideshow/">a small Node service</a> that turns them into a slideshow.
      </p>
    </div>
    <Wireframe />
  </section>

  <section class="index" id="projects">
    <h2>Projects</h2>
    <ul>
      {
        projects.map((p, i) => (
          <li class:list={['entry', { lead: i === 0 }]}>
            <div class="head">
              <h3>
                <a href={`/projects/${p.id}/`}>{p.data.title}</a>
              </h3>
              <p class="status">{statusLabel[p.data.status]}</p>
            </div>
            <div class="text">
              <p class="summary">{p.data.summary}</p>
              <p class="stack">{p.data.stack.join(', ')}</p>
            </div>
            <a class="thumb" href={`/projects/${p.id}/`} tabindex="-1" aria-hidden="true">
              {p.data.image ? (
                <Image
                  src={p.data.image}
                  alt=""
                  widths={[240, 480]}
                  sizes="(min-width: 48rem) 15rem, 7.5rem"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="pending">Screenshot coming soon</span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  const typed = document.querySelector<HTMLElement>('.typed');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // On a slow connection the CSS fallback may already have shown the headline; don't hide it again to retype it.
  if (typed && !reduce && performance.now() < 2400) {
    const chars = [...typed.querySelectorAll<HTMLElement>('.ch')];
    let i = 0;
    const tick = () => {
      chars[i - 1]?.classList.remove('at');
      const ch = chars[i++];
      ch.classList.add('on', 'at');
      if (i < chars.length) {
        // Uneven timing, with a beat after punctuation, reads more like a hand on keys.
        setTimeout(tick, /[,.]/.test(ch.textContent ?? '') ? 260 : 28 + Math.random() * 40);
      } else {
        // The caret blinks a few times, then goes (WCAG 2.2.2: nothing blinks for more than 5 seconds).
        typed.classList.add('done');
        ch.addEventListener('animationend', () => ch.classList.remove('at'), { once: true });
      }
    };
    const start = () => {
      typed.classList.add('running');
      setTimeout(tick, 200);
    };
    // Background tabs throttle timers to about one a second, which would crawl through the headline.
    // Opened in a background tab, it waits to be seen. Nobody has seen the CSS fallback by then either.
    if (document.hidden) document.addEventListener('visibilitychange', start, { once: true });
    else start();
  }
</script>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding: clamp(1.5rem, 6vh, 4rem) 0 clamp(3rem, 10vh, 6rem);
  }
  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 4rem;
      min-height: min(78svh, 46rem);
    }
  }
  h1 {
    font-size: clamp(2.6rem, 6.2vw, 4.6rem);
    font-weight: 330;
    line-height: 1.04;
    letter-spacing: -0.022em;
    margin: 0 0 1.75rem;
    max-width: 13ch;
    text-wrap: balance;
  }
  .word {
    white-space: nowrap;
  }
  .ch {
    position: relative;
  }
  /*
    Hidden before first paint only when the script will run, so there's no flash of the full line.
    Without JS, or with reduced motion, the headline just shows. If the script never starts,
    the fallback animation shows every letter after 2.5s anyway.
  */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .ch {
      visibility: hidden;
      animation: show 0s 2.5s forwards;
    }
    .running .ch {
      animation: none;
    }
    .ch.on {
      visibility: visible;
    }
  }
  @keyframes show {
    to {
      visibility: visible;
    }
  }
  /* The caret is positioned, not inline, so it never changes where lines wrap. */
  .at::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 0.3em;
    height: 0.74em;
    width: 0.055em;
    margin-left: 0.04em;
    background: var(--wire);
  }
  .done .at::after {
    animation: blink 1.05s steps(1) 3;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .lede {
    font-size: 1.375rem;
    line-height: 1.5;
    max-width: var(--measure);
    margin: 0 0 1.1rem;
  }
  .proof {
    max-width: var(--measure);
    margin: 0;
    color: var(--muted);
  }
  .proof a {
    color: var(--text);
    text-decoration-color: var(--wire);
  }

  /* Project index: weighted by importance, not boxed. */
  .index {
    padding-bottom: 2rem;
  }
  h2 {
    font-size: 1.75rem;
    margin: 0 0 2rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entry {
    display: grid;
    gap: 1rem 1.25rem;
    padding: 2rem 0;
    border-top: 1px solid var(--rule);
    grid-template-columns: minmax(0, 1fr) 7.5rem;
    grid-template-areas: 'head thumb' 'text text';
    align-items: start;
  }
  .head {
    grid-area: head;
  }
  .text {
    grid-area: text;
  }
  .thumb {
    grid-area: thumb;
    display: block;
    text-decoration: none;
  }
  .thumb img,
  .pending {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--well);
    border: 1px solid var(--rule);
    border-radius: 3px;
  }
  .thumb:hover img {
    border-color: var(--wire);
  }
  .pending {
    display: grid;
    place-items: center;
    text-align: center;
    padding: 0.5rem;
    font-style: italic;
    font-size: 0.85rem;
    line-height: 1.3;
    color: var(--muted);
  }
  h3 {
    margin: 0;
    font-size: 2rem;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--wire);
  }
  .status {
    margin: 0.35rem 0 0;
    font-style: italic;
    color: var(--muted);
    font-size: 1rem;
  }
  .summary {
    margin: 0 0 0.6rem;
    max-width: var(--measure);
  }
  .stack {
    margin: 0;
  }
  @media (min-width: 48rem) {
    .entry {
      grid-template-columns: 13rem minmax(0, 1fr) 15rem;
      grid-template-areas: 'head text thumb';
      gap: 0.5rem 2.5rem;
    }
    .thumb img,
    .pending {
      aspect-ratio: 16 / 10;
    }
  }

  /* The lead project leads with type, not a bigger picture. */
  .lead h3 {
    font-size: clamp(2.4rem, 4vw, 2.85rem);
    font-weight: 330;
  }
  .lead .summary {
    font-size: 1.3rem;
    line-height: 1.5;
  }
</style>
