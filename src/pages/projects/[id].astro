---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { EXTERNAL_REL } from '../../lib/externalLinks';
import { projectJsonLd } from '../../lib/structuredData';
import { splitTechnical } from '../../lib/technicalDetails';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
// A "## Technical details" section, if the page has one, goes into a collapsed <details> (src/lib/technicalDetails.ts).
const { main, technical } = splitTechnical(project.rendered?.html ?? '');
if (technical !== null && project.rendered?.metadata?.imagePaths?.length) {
  // The split uses the rendered HTML directly, which skips Astro's processing of Markdown images.
  throw new Error(`${project.id}: Markdown images aren't supported on a page with a Technical details section.`);
}
// Social cards: a JPEG copy of the screenshot (WebP isn't read everywhere that unfurls links).
const og = project.data.image
  ? await getImage({ src: project.data.image, format: 'jpeg', width: Math.min(1200, project.data.image.width) })
  : undefined;
---

<Base
  title={project.data.title}
  description={project.data.summary}
  type="article"
  image={og && { src: og.src, alt: project.data.imageAlt ?? '' }}
  jsonLd={projectJsonLd(project.data, new URL(Astro.url.pathname, Astro.site), Astro.site!)}
>
  <article>
    <a href="/#projects" class="back">All projects</a>
    <h1>{project.data.title}</h1>
    <p class="summary">{project.data.summary}</p>
    <p class="stack">{project.data.stack.join(', ')}</p>
    <p class="repo">
      <a href={project.data.repo} rel={EXTERNAL_REL}>View the source on GitHub</a>
    </p>
    {
      project.data.image && (
        <Image
          class="shot"
          src={project.data.image}
          alt={project.data.imageAlt ?? ''}
          widths={[480, 840, 1280]}
          sizes="(min-width: 46rem) 42rem, calc(100vw - 2rem)"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    {technical === null && <div class="prose"><Content /></div>}
    {technical !== null && <div class="prose" set:html={main} />}
    {
      technical !== null && (
        <details class="disclosure deep">
          <summary>Technical details</summary>
          <div class="prose" set:html={technical} />
        </details>
      )
    }
  </article>
</Base>

<style>
  article {
    max-width: 42rem;
    padding-top: 1.5rem;
  }
  .back {
    font-size: 1rem;
    color: var(--muted);
    font-style: italic;
    text-decoration: none;
  }
  .back:hover {
    color: var(--text);
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 3.75rem);
    font-weight: 330;
    letter-spacing: -0.022em;
    margin: 1rem 0 0.75rem;
  }
  .summary {
    font-size: 1.375rem;
    line-height: 1.5;
    margin: 0 0 0.5rem;
  }
  .stack {
    margin: 0;
  }
  .repo {
    margin: 1.25rem 0 0;
  }
  .shot {
    width: 100%;
    margin: 2rem 0 0.5rem;
    background: var(--well);
    border: 1px solid var(--rule);
    border-radius: 3px;
  }
  .prose :global(h2) {
    font-size: 1.6rem;
    margin: 2.5rem 0 0.75rem;
  }
  .prose :global(li) {
    margin-bottom: 0.4rem;
  }
  .prose :global(li::marker) {
    color: var(--muted);
  }
  /* The collapsed technical section: spaced like an h2, with its summary at h2 size. */
  .deep {
    margin-top: 2.5rem;
  }
  .deep > summary {
    font-size: 1.6rem;
    font-weight: 400;
    /* No rule under it here (Clark's call): it reads as a heading, like the page's other sections. */
    border-bottom: 0;
    padding-bottom: 0;
  }
  .deep > .prose > :global(:first-child) {
    margin-top: 1rem;
  }
</style>
